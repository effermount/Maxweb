{
  "name": "maxweb",
  "productName": "Обла",
  "version": "1.2.14",
  "description": "Обла — MAX, Telegram, WhatsApp и VK в одном приложении",
  "private": true,
  "main": "src/main.cjs",
  "author": "Обла",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:runtime": "node scripts/test-runtime.cjs",
    "test:installer": "node tests/install-e2e.cjs",
    "test:github": "electron tests/github-runtime.cjs",
    "icons": "swift scripts/icons.swift",
    "prebuild": "node scripts/prepare-build.cjs",
    "build": "electron-builder --mac dir --universal",
    "predist": "node scripts/prepare-build.cjs",
    "dist": "electron-builder --mac dmg --universal",
    "postdist": "node scripts/release.cjs",
    "release:files": "node scripts/release.cjs",
    "publish:release": "node scripts/publish-release.cjs",
    "test:account-notifications": "electron tests/account-notifications-runtime.cjs",
    "test:vk": "electron tests/vk-runtime.cjs",
    "test:whatsapp": "electron tests/whatsapp-runtime.cjs",
    "test:account-order": "electron tests/account-order-runtime.cjs",
    "test:sidebar": "electron tests/sidebar-layout-runtime.cjs",
    "test:telegram": "electron tests/telegram-runtime.cjs",
    "test:scroll": "electron tests/scroll-runtime.cjs",
    "test:account-lifecycle": "electron tests/account-lifecycle-runtime.cjs",
    "test:lock-screen": "electron tests/lock-screen-runtime.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.maxweb.desktop",
    "productName": "Maxweb",
    "artifactName": "Obla-${version}-universal.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/*.png",
      "assets/release-public.pem",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "CFBundleDisplayName": "Maxweb",
        "CFBundleDevelopmentRegion": "ru",
        "CFBundleLocalizations": [
          "ru",
          "en"
        ],
        "NSCameraUsageDescription": "Камера используется для видеозвонков в мессенджерах после вашего разрешения.",
        "NSMicrophoneUsageDescription": "Микрофон используется для звонков и голосовых сообщений после вашего разрешения.",
        "NSUserNotificationAlertStyle": "alert",
        "LSHasLocalizedDisplayName": true
      },
      "extraResources": [
        {
          "from": "assets/InfoPlist.strings",
          "to": "ru.lproj/InfoPlist.strings"
        },
        {
          "from": "assets/InfoPlist.strings",
          "to": "en.lproj/InfoPlist.strings"
        }
      ]
    },
    "dmg": {
      "title": "Установка «Обла»",
      "background": "assets/dmg-background.png",
      "window": {
        "width": 600,
        "height": 420
      },
      "iconSize": 100,
      "contents": [
        {
          "x": 160,
          "y": 180,
          "type": "file"
        },
        {
          "x": 440,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
